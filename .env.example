# Copy this file to ".env" and fill in your key. ".env" is gitignored — never commit it.

# --- LLM provider ---------------------------------------------------------
# Which provider to use: "gemini" (default), or later "groq" / "openai-compatible".
LLM_PROVIDER=gemini

# Get a free key at https://ai.google.dev -> "Get API Key" (Google account, no credit card).
GEMINI_API_KEY=your-key-here

# Model name. Swapping models is a one-line change here.
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to skip all real API calls and use canned fixture responses.
# Used for tests and offline development. No key needed when true.
MOCK_LLM=true

# --- Pipeline tuning ------------------------------------------------------
# Max emails processed per minute in live mode (keeps us inside Gemini free limits).
PIPELINE_RATE_LIMIT_PER_MIN=10

# How often (seconds) the pipeline runner polls the inbox for new emails.
PIPELINE_POLL_SECONDS=5

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///data/smartsupport.db
